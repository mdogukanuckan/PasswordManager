<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordManager.Client.Views.AddVaultItemPage"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="#B3080608"
             Title="Yeni Kayıt">

    <Grid>
        <Border Style="{StaticResource Card}"
                WidthRequest="{OnIdiom Phone=-1, Default=520}"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto"
                      Padding="28,24,28,20">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="5">
                        <Label Text="Yeni Kayıt"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Kasaya yeni bir şifre kaydı ekleyin."
                               Style="{StaticResource Muted}"
                               FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="✕"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{StaticResource StrokeSoft}"/>

                <VerticalStackLayout Padding="28,24"
                                     Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Başlık"
                               Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}"
                                HeightRequest="40">
                            <Entry Placeholder="Örn. Bilgisayar Şifresi"
                                   FontSize="13"
                                   Text="{Binding Title}"/>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="6">
                            <Label Text="Kullanıcı adı"
                                   Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorder}"
                                    HeightRequest="40">
                                <Entry Placeholder="kullanici"
                                       FontSize="13"
                                       Text="{Binding Username}"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">
                            <Label Text="Kategori"
                                   Style="{StaticResource FieldLabel}"/>

                            <Border Style="{StaticResource FieldBorder}"
                                    HeightRequest="40">
                                <Picker  FontSize="13"
                                         TextColor="{StaticResource TextPrimary}"
                                         TitleColor="{StaticResource TextFaint}"
                                         BackgroundColor="Transparent"
                                         SelectedItem="{Binding CategoryPicker.SelectedCategory}"
                                         ItemsSource="{Binding CategoryPicker.AvailableCategories}">
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Şifre"
                               Style="{StaticResource FieldLabel}"/>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    Style="{StaticResource FieldBorder}"
                                    HeightRequest="40">
                                <Entry Placeholder="••••••••••"
                                       Style="{StaticResource MonoEntry}"
                                       FontSize="13"
                                       IsPassword="True"
                                       Text="{Binding Password}"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Üret"
                                    Style="{StaticResource GhostButton}"
                                    TextColor="{StaticResource Accent}"
                                    HeightRequest="40"
                                    FontSize="12"
                                    Command="{Binding GeneratePasswordCommand}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notlar"
                               Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBorder}"
                                HeightRequest="76"
                                Padding="12,4">
                            <Editor Placeholder="İsteğe bağlı"
                                    FontSize="13"
                                    AutoSize="Disabled"
                                    Text="{Binding Notes}"/>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         Color="{StaticResource StrokeSoft}"/>
                <Grid BackgroundColor="#141118"
                      Padding="28,16"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="1"
                            Text="İptal"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="40"
                            Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="2"
                            Text="Kaydet"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="40"
                            Command="{Binding SaveCommand}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
