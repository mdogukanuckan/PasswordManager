<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordManager.Client.Views.ManageCategoriesPage"
             x:Name="Root"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="#B3080608"
             Title="Kategorileri Yönet">

    <Grid>
        <Border Style="{StaticResource Card}"
                WidthRequest="{OnIdiom Phone=-1, Default=520}"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">

            <VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto"
                      Padding="28,24,28,20">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="5">
                        <Label Text="Kategorileri Yönet"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Kasa kategorilerini ekleyin veya silin."
                               Style="{StaticResource Muted}"
                               FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="✕"
                           FontSize="14"
                           TextColor="{StaticResource TextMuted}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{StaticResource StrokeSoft}"/>

                <VerticalStackLayout Padding="28,24"
                                     Spacing="16">

                    <Button Text="+ Yeni Kategori"
                            Style="{StaticResource GhostButton}"
                            HorizontalOptions="Start"
                            Command="{Binding CategoryPicker.AddCategoryCommand}"/>

                    <CollectionView ItemsSource="{Binding CategoryPicker.AvailableCategories}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      Padding="0,8">

                                    <Label Text="{Binding .}"
                                           VerticalOptions="Center"/>

                                    <Button Grid.Column="1"
                                            Text="Düzenle"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding BindingContext.CategoryPicker.RenameCategoryCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Grid.Column="2"
                                            Text="Sil"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding BindingContext.CategoryPicker.DeleteCategoryCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>