<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PasswordManager.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PasswordManager.Client"
    xmlns:views="clr-namespace:PasswordManager.Client.Views"
    FlyoutBehavior="Disabled"
    Title="PasswordManager.Client">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"/>
    <ShellContent
        Title="Homepage"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage"/>
    <ShellContent
        Title="Unlock"
        ContentTemplate="{DataTemplate views:UnlockPage}"
        Route="UnlockPage"/>

</Shell>
